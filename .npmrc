# This project installs from the public npm registry, whatever the machine's user-level
# ~/.npmrc says. The repo is public: a lockfile resolved through a private mirror would record
# that mirror's URLs, exposing an internal hostname and breaking `npm install` for anyone
# who cannot reach it.
#
# npm ranks environment variables above every .npmrc, so a shell that exports
# NPM_CONFIG_REGISTRY still wins over this file. There, pass the registry explicitly:
#   npm install --registry=https://registry.npmjs.org/
registry=https://registry.npmjs.org/

# Refuse to install on a Node the project does not support (package.json "engines"), instead of
# installing and failing later with an obscure error from the test runner. The floor is vitest's:
# it needs ^22.12 || ^24 || >=26. .nvmrc pins the version developers and CI actually use.
engine-strict=true
